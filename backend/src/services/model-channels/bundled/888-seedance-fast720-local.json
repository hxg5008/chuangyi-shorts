{
  "apiVersion": "yingce.plugin/v2",
  "id": "888-seedance-fast720-local",
  "name": "888API Seedance 2.0 Fast 720p",
  "version": "1.0.0",
  "author": "Chuangyi integration",
  "description": "888API Seedance 2.0 Fast 720p 专用协议：/v1/videos、images、seconds、ratio。",
  "documentation": "来源：https://888api.xin/docs#seedance2.0-fast-720p 以及官方video-plugin-2.3.3的_build_video_payload。仅seedance2.0-fast-720p，4–15秒，720p，最多30张参考图。请求images URL数组，顺序对应@image1…；禁止参考视频/音频及首尾帧混用。旧请求仍按原任务号查询。",
  "permissions": [
    "generation.run",
    "media.read"
  ],
  "configuration": {
    "fields": [
      {
        "name": "apiKey",
        "type": "secret",
        "label": "API Key",
        "required": true
      }
    ]
  },
  "contributes": {
    "providers": [
      {
        "id": "888-seedance-fast720-local",
        "label": "888API · Seedance 2.0 Fast 720p",
        "capabilities": [
          "video"
        ],
        "scopes": [
          "admin.system-channel",
          "user.custom-channel",
          "canvas",
          "creation",
          "agent"
        ],
        "baseUrl": "https://888api.xin",
        "requiresPublicMediaUrls": true,
        "auth": {
          "type": "bearer",
          "field": "apiKey"
        },
        "parameters": [
          {
            "name": "model",
            "type": "string",
            "required": true,
            "mapping": "model",
            "values": [
              "seedance2.0-fast-720p"
            ],
            "description": "仅此型号，不能混用C5/MAX"
          },
          {
            "name": "prompt",
            "type": "string",
            "required": true,
            "mapping": "prompt",
            "description": "完整原始视频提示词。"
          },
          {
            "name": "images",
            "type": "media[]",
            "mapping": "images",
            "description": "最多30张参考图，按顺序对应@image1至@image30"
          },
          {
            "name": "duration",
            "type": "integer",
            "required": true,
            "mapping": "seconds",
            "description": "4至15整数秒",
            "min": 4,
            "max": 15
          },
          {
            "name": "aspectRatio",
            "type": "string",
            "mapping": "ratio",
            "description": "比例，默认16:9"
          },
          {
            "name": "resolution",
            "type": "string",
            "mapping": "resolution",
            "values": [
              "720p"
            ],
            "description": "此型号固定 720p。",
            "binding": "resolution"
          }
        ],
        "validations": [
          {
            "assert": {
              "$eq": [
                {
                  "$ref": "request.model"
                },
                "seedance2.0-fast-720p"
              ]
            },
            "message": "此协议仅适配888API seedance2.0-fast-720p"
          },
          {
            "assert": {
              "$gt": [
                {
                  "$len": {
                    "$trim": {
                      "$ref": "request.prompt"
                    }
                  }
                },
                0
              ]
            },
            "message": "视频提示词不能为空。"
          },
          {
            "assert": {
              "$and": [
                {
                  "$gte": [
                    {
                      "$ref": "request.duration"
                    },
                    4
                  ]
                },
                {
                  "$lte": [
                    {
                      "$ref": "request.duration"
                    },
                    15
                  ]
                }
              ]
            },
            "message": "时长须为4至15整数秒"
          },
          {
            "assert": {
              "$in": [
                {
                  "$coalesce": [
                    {
                      "$ref": "request.resolution"
                    },
                    "720p"
                  ]
                },
                [
                  "",
                  "720p",
                  "720P"
                ]
              ]
            },
            "message": "此型号只支持720p"
          },
          {
            "assert": {
              "$in": [
                {
                  "$coalesce": [
                    {
                      "$ref": "request.aspectRatio"
                    },
                    "16:9"
                  ]
                },
                [
                  "",
                  "16:9",
                  "9:16",
                  "1:1",
                  "4:3",
                  "3:4",
                  "21:9"
                ]
              ]
            },
            "message": "所选画幅不在本插件已声明范围内。"
          },
          {
            "assert": {
              "$in": [
                {
                  "$coalesce": [
                    {
                      "$ref": "request.operation"
                    },
                    "text_to_video"
                  ]
                },
                [
                  "",
                  "text_to_video",
                  "reference_to_video"
                ]
              ]
            },
            "message": "此协议仅支持文生视频和普通参考图片，不支持首尾帧、视频或音频参考。"
          },
          {
            "assert": {
              "$lte": [
                {
                  "$len": {
                    "$ref": "request.images"
                  }
                },
                30
              ]
            },
            "message": "此型号最多30张参考图，不截断"
          },
          {
            "assert": {
              "$lte": [
                {
                  "$len": {
                    "$ref": "request.videos"
                  }
                },
                0
              ]
            },
            "message": "此型号暂不支持参考视频"
          },
          {
            "assert": {
              "$lte": [
                {
                  "$len": {
                    "$ref": "request.audios"
                  }
                },
                0
              ]
            },
            "message": "此型号暂不支持参考音频"
          },
          {
            "assert": {
              "$eq": [
                {
                  "$len": {
                    "$filter": {
                      "from": {
                        "$ref": "request.images"
                      },
                      "as": "media",
                      "where": {
                        "$in": [
                          {
                            "$ref": "media.role"
                          },
                          [
                            "first_frame",
                            "last_frame",
                            "first",
                            "last",
                            "mask"
                          ]
                        ]
                      }
                    }
                  }
                },
                0
              ]
            },
            "message": "本插件没有声明首尾帧或蒙版字段，不能把它们静默转成普通参考图。"
          }
        ],
        "create": {
          "method": "POST",
          "path": "/v1/videos",
          "originPath": true,
          "contentType": "application/json",
          "body": {
            "model": {
              "$ref": "request.model"
            },
            "prompt": {
              "$ref": "request.prompt"
            },
            "ratio": {
              "$coalesce": [
                {
                  "$ref": "request.aspectRatio"
                },
                "16:9"
              ]
            },
            "resolution": "720p",
            "images": {
              "$omitEmpty": {
                "$map": {
                  "from": {
                    "$sortByOrder": {
                      "$ref": "request.images"
                    }
                  },
                  "as": "media",
                  "in": {
                    "$ref": "media.value"
                  }
                }
              }
            },
            "seconds": {
              "$ref": "request.duration"
            }
          }
        },
        "poll": {
          "method": "GET",
          "path": "/v1/videos/{{taskId}}",
          "originPath": true
        },
        "result": {
          "method": "GET",
          "path": "/v1/videos/{{taskId}}/content",
          "originPath": true,
          "headers": {
            "Accept": "video/mp4"
          }
        },
        "response": {
          "taskId": {
            "$coalesce": [
              {
                "$ref": "response.id"
              },
              {
                "$ref": "response.task_id"
              },
              {
                "$ref": "response.data.id"
              },
              {
                "$ref": "response.data.task_id"
              },
              {
                "$ref": "taskId"
              }
            ]
          },
          "status": {
            "$coalesce": [
              {
                "$ref": "response.status"
              },
              {
                "$ref": "response.data.status"
              },
              "pending"
            ]
          },
          "message": {
            "$coalesce": [
              {
                "$ref": "response.error.message"
              },
              {
                "$ref": "response.message"
              },
              {
                "$ref": "response.fail_reason"
              },
              {
                "$ref": "response.data.error.message"
              }
            ]
          },
          "videos": {
            "$coalesce": [
              {
                "$ref": "response.url"
              },
              {
                "$ref": "response.video_url"
              },
              {
                "$ref": "response.result_url"
              },
              {
                "$ref": "response.output_url"
              },
              {
                "$ref": "response.metadata.url"
              },
              {
                "$ref": "response.data.url"
              },
              {
                "$ref": "response.data.video_url"
              },
              {
                "$ref": "response.data.result_url"
              },
              {
                "$ref": "response.data.metadata.url"
              }
            ]
          },
          "errorPaths": [
            "error.code"
          ],
          "resultEphemeral": true
        }
      }
    ]
  }
}
