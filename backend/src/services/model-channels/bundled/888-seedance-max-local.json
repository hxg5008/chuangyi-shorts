            "mapping": "images",
            "description": "?? 9 ????????????? order ?????"
          },
          {
            "name": "videos",
            "type": "media[]",
            "mapping": "videos",
            "description": "?? 3 ????????????"
          },
          {
            "name": "audios",
            "type": "media[]",
            "mapping": "audios",
            "description": "?? 3 ????????????"
          },
          {
            "name": "duration",
            "type": "integer",
            "required": true,
            "mapping": "duration",
            "description": "4 ? 15 ????"
          },
          {
            "name": "aspectRatio",
            "type": "string",
            "mapping": "ratio",
            "description": "画幅比例，缺省 16:9。"
          },
          {
