        ],
        "validations": [
          {
            "assert": {
              "$eq": [
                {
                  "$ref": "request.model"
                },
                "seedance2.0-933-c5-fast"
              ]
            },
            "message": "此插件只适配 888API seedance2.0-933-c5-fast。"
          },
          {
            "assert": {
              "$gt": [
                {
                  "$len": {
                    "$trim": {
                      "$ref": "request.prompt"
                    }
                  }
                },
                0
              ]
            },
            "message": "视频提示词不能为空。"
          },
          {
            "assert": {
              "$and": [
                {
                  "$gte": [
                    {
                      "$ref": "request.duration"
                    },
                    4
                  ]
                },
                {
                  "$lte": [
                    {
                      "$ref": "request.duration"
                    },
                    15
                  ]
                }
              ]
            },
            "message": "888API C5 Fast ?????? 4 ? 15 ????"
          },
          {
            "assert": {
              "$in": [
                {
                  "$coalesce": [
                    {
                      "$ref": "request.resolution"
                    },
                    ""
                  ]
                },
                [
                  "",
                  "720p",
                  "720P"
                ]
              ]
            },
            "message": "888API C5 Fast 仅支持 720p。"
          },
          {
            "assert": {
              "$in": [
                {
                  "$coalesce": [
                    {
                      "$ref": "request.aspectRatio"
                    },
                    ""
                  ]
                },
                [
                  "",
                  "16:9",
                  "9:16",
                  "1:1",
                  "4:3",
                  "3:4",
                  "21:9"
                ]
              ]
            },
            "message": "所选画幅不在本插件已声明范围内。"
          },
          {
            "assert": {
              "$in": [
                {
                  "$coalesce": [
                    {
                      "$ref": "request.operation"
                    },
                    ""
                  ]
                },
                [
                  "",
                  "text_to_video",
                  "reference_to_video"
                ]
              ]
            },
            "message": "此已核验合同仅开放文生视频和参考图生视频，请使用并行出片。"
          },
          {
            "assert": {
              "$lte": [
                {
                  "$len": {
                    "$ref": "request.images"
                  }
                },
                9
              ]
            },
            "message": "888API C5 Fast ?? 9 ????????????"
          },
          {
            "assert": {
              "$lte": [
                {
                  "$len": {
                    "$ref": "request.videos"
                  }
                },
                3
              ]
            },
            "message": "888API C5 Fast ?? 3 ?????????????"
          },
          {
            "assert": {
              "$lte": [
                {
                  "$len": {
                    "$ref": "request.audios"
                  }
                },
                3
              ]
            },
            "message": "888API C5 Fast ?? 3 ?????????????"
          },
          {
            "assert": {
              "$eq": [
                {
                  "$len": {
                    "$filter": {
                      "from": {
                        "$ref": "request.images"
                      },
                      "as": "media",
                      "where": {
                        "$in": [
                          {
                            "$ref": "media.role"
                          },
                          [
                            "first_frame",
                            "last_frame",
                            "first",
                            "last",
                            "mask"
                          ]
                        ]
                      }
                    }
                  }
                },
                0
              ]
            },
            "message": "本插件没有声明首尾帧或蒙版字段，不能把它们静默转成普通参考图。"
          },
          {
            "assert": {
              "$eq": [
                {
                  "$ref": "request.generateAudio"
                },
                true
              ]
            },
            "message": "888API C5 Fast 是原生音频型号，当前合同未提供关闭音频开关，请在模型能力中保持音频开启。"
          },
          {
            "assert": {
              "$eq": [
                {
                  "$ref": "request.watermark"
                },
                false
              ]
            },
            "message": "该型号文档未提供水印开关，请使用服务器默认。"
          }
        ],
        "create": {
          "method": "POST",
          "path": "/v1/videos",
          "originPath": true,
          "contentType": "application/json",
          "body": {
            "model": {
              "$ref": "request.model"
            },
            "prompt": {
              "$ref": "request.prompt"
            },
            "duration": {
              "$ref": "request.duration"
            },
            "ratio": {
              "$coalesce": [
                {
                  "$ref": "request.aspectRatio"
                },
                "16:9"
              ]
            },
            "resolution": "720p",
            "images": {
              "$omitEmpty": {
                "$map": {
                  "from": {
                    "$sortByOrder": {
                      "$ref": "request.images"
                    }
                  },
                  "as": "media",
                  "in": {
                    "$ref": "media.value"
                  }
                }
              }
            },
            "videos": {
              "$omitEmpty": {
                "$map": {
                  "from": {
                    "$sortByOrder": {
                      "$ref": "request.videos"
                    }
                  },
                  "as": "media",
                  "in": {
                    "$ref": "media.value"
                  }
                }
              }
            },
            "audios": {
              "$omitEmpty": {
                "$map": {
                  "from": {
                    "$sortByOrder": {
                      "$ref": "request.audios"
                    }
                  },
                  "as": "media",
                  "in": {
                    "$ref": "media.value"
                  }
                }
              }
            }
          }
        },
        "poll": {
          "method": "GET",
          "path": "/v1/videos/{{taskId}}",
          "originPath": true
        },
        "result": {
          "method": "GET",
          "path": "/v1/videos/{{taskId}}/content",
          "originPath": true,
          "headers": {
            "Accept": "video/mp4"
          }
        },
        "response": {
          "taskId": {
            "$coalesce": [
              {
                "$ref": "response.id"
              },
              {
                "$ref": "response.task_id"
              },
              {
                "$ref": "response.data.id"
              },
              {
                "$ref": "response.data.task_id"
              },
              {
                "$ref": "taskId"
              }
            ]
          },
          "status": {
            "$coalesce": [
              {
                "$ref": "response.status"
              },
              {
                "$ref": "response.data.status"
              },
              "pending"
            ]
          },
          "message": {
            "$coalesce": [
              {
                "$ref": "response.error.message"
              },
              {
                "$ref": "response.message"
              },
              {
                "$ref": "response.fail_reason"
              },
              {
                "$ref": "response.data.error.message"
              }
            ]
          },
          "videos": {
            "$coalesce": [
              {
                "$ref": "response.url"
              },
              {
                "$ref": "response.video_url"
              },
              {
                "$ref": "response.result_url"
              },
              {
                "$ref": "response.output_url"
              },
              {
                "$ref": "response.metadata.url"
              },
              {
                "$ref": "response.data.url"
              },
              {
                "$ref": "response.data.video_url"
              },
              {
                "$ref": "response.data.result_url"
              },
              {
                "$ref": "response.data.metadata.url"
              }
            ]
          },
          "errorPaths": [
            "error.code"
          ],
          "resultEphemeral": true
        }
      }
    ]
  }
}
